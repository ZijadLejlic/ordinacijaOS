# Copy to `.env.local` and fill in values from Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose to the browser / client components
SUPABASE_SERVICE_ROLE_KEY=

# App URL used in invite / reset emails (no trailing slash).
# Local: http://localhost:3000 — production: https://dentord.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (D9, D23, D44). Domain dentord.com must be Verified in Resend.
# Without RESEND_API_KEY, invite links are logged in development only.
# Transactional From: noreply@ — also create support@ / hello@ as Resend senders if needed.
RESEND_API_KEY=
EMAIL_FROM=DentOrd <noreply@dentord.com>
# Optional override for Reply-To (default: support@dentord.com)
# EMAIL_REPLY_TO=support@dentord.com

# Optional salt for hashing contact-form IPs (rate limit). Falls back to service role key slice.
# LEAD_IP_HASH_SALT=

# Sentry (optional). Without DSN, SDK is disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (optional, EU host default). No patient PII — clinic_id/role/events only (D33).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Marketing live demo clinic (W8). Set after running: npx tsx scripts/seed-demo-clinic.ts
# DEMO_CLINIC_EMAIL=demo@dentord.com
# DEMO_CLINIC_PASSWORD=

# Cron (Vercel Cron / manual). Required for trial expiry → readonly → hard delete (D6/D45).
# Vercel sends Authorization: Bearer $CRON_SECRET to /api/cron/clinic-lifecycle
CRON_SECRET=

# Playwright E2E (npm run test:e2e) — same Supabase keys as above + service role for seed/cleanup.
# Optional override; default http://127.0.0.1:3000
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# Auth project must auto-confirm email (or signup flow stops at confirmEmail).
