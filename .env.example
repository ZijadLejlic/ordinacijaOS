# Copy to `.env.local` and fill in values from Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose to the browser / client components
SUPABASE_SERVICE_ROLE_KEY=

# App URL used in invite / reset emails (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (D9). Without RESEND_API_KEY, invite links are logged in development only.
RESEND_API_KEY=
EMAIL_FROM=OrdinacijaOS <onboarding@resend.dev>
