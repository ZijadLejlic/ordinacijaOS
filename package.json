{
  "name": "ordinacija-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "HOSTNAME=${HOSTNAME:-localhost} next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:security",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"lib/security/tenant-isolation.test.ts\" --exclude \"lib/security/tenant-isolation-expanded.test.ts\" --exclude \"lib/security/rbac-and-lifecycle.test.ts\" --exclude \"lib/security/storage-isolation.test.ts\"",
    "test:coverage": "vitest run --exclude \"lib/security/tenant-isolation.test.ts\" --exclude \"lib/security/tenant-isolation-expanded.test.ts\" --exclude \"lib/security/rbac-and-lifecycle.test.ts\" --exclude \"lib/security/storage-isolation.test.ts\" --coverage",
    "test:security": "vitest run lib/security/tenant-isolation.test.ts lib/security/tenant-isolation-expanded.test.ts lib/security/rbac-and-lifecycle.test.ts lib/security/storage-isolation.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dev": "PLAYWRIGHT_WEB_SERVER=dev PLAYWRIGHT_REUSE_SERVER=1 playwright test",
    "seed:demo": "npx tsx scripts/seed-demo-clinic.ts",
    "generate:marketing-shots": "node scripts/generate-marketing-screenshots.mjs",
    "lighthouse:marketing": "node scripts/lighthouse-marketing.mjs",
    "check:production-ops": "node scripts/check-production-ops.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "next-mdx-remote": "^6.0.0",
    "posthog-js": "^1.399.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/exceljs": "^0.5.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "otpauth": "^9.5.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  }
}
